# Local: copy this file to .env. Leave APP_PASSWORD unset to choose a password
# on the first visit from http://localhost:5173 on this computer.
# Production: APP_PASSWORD (12+ characters) and APP_ORIGIN are REQUIRED.
# APP_PASSWORD=replace-with-your-own-long-private-password
# APP_ORIGIN=https://your-domain.example
PORT=3001
DATABASE_PATH=./data/exchange-life.sqlite
# NODE_ENV=production
# Personal iOS container: HTTPS origin of the deployed app, no path.
# IOS_APP_URL=https://your-domain.example
